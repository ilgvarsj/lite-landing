---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company, locations } from '../data/site';
import { t } from '../i18n/lv';
import defaultOg from '../assets/hero.jpg';

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  /** Set when the title is already a full SEO title (e.g. imported from Yoast). */
  rawTitle?: boolean;
}

const { title, description = 'Ražots Latvijā: logu žalūzijas, aizkari, aizsargžalūzijas, moskītu tīkli, aizkaru stiprinājumi. Pilns serviss no mērīšanas līdz uzstādīšanai.', image = defaultOg, rawTitle = false } = Astro.props;

const raw = rawTitle ? title.replace(/\|\s*lite$/i, '| LITE') : `${title} | LITE`;
const fullTitle = raw.charAt(0).toLocaleUpperCase('lv') + raw.slice(1);
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.legalName,
  url: company.url,
  foundingDate: String(company.founded),
  email: company.email,
  telephone: company.phone,
  sameAs: Object.values(company.socials),
  department: locations.map((l) => ({
    '@type': 'HomeAndConstructionBusiness',
    name: `LITE – ${l.name}`,
    telephone: l.phone,
    email: l.email,
    address: { '@type': 'PostalAddress', streetAddress: l.street, addressLocality: l.city, addressCountry: 'LV' },
  })),
};
---

<!doctype html>
<html lang="lv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1b2b69" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="lv_LV" />
    <meta property="og:site_name" content="LITE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(og.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="lv" href={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#saturs" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-navy-800 focus:px-5 focus:py-3 focus:text-white">
      {t('skip')}
    </a>
    <Header />
    <main id="saturs" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Fade-in on scroll for elements marked .reveal
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
