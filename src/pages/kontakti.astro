---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { company, locations, requisites, team, telHref } from '../data/site';
import { t } from '../i18n/lv';

---

<BaseLayout title="Kontakti" description="LITE kontakti: fabrika–salons Krūzes ielā 3 un aizkaru salons Tērbatas ielā 93/95, Rīgā. Tālr. +371 67619001, info@lite.lv.">
  <section class="border-b border-sand-200">
    <div class="container-x py-10 lg:py-14">
      <Breadcrumbs items={[{ title: t('nav.contacts') }]} />
      <h1 class="mt-6 text-4xl sm:text-5xl lg:text-6xl">Kontakti</h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">Gaidīsim jūs klātienē Pārdaugavā vai Rīgas centrā – vai arī piezvaniet, un mūsu speciālisti ieradīsies pie jums.</p>
    </div>
  </section>

  <section class="py-14 lg:py-20">
    <div class="container-x grid gap-6 lg:grid-cols-2">
      {locations.map((l) => (
        <article class="overflow-hidden rounded-[2rem] bg-white ring-1 ring-sand-200">
          <iframe src={l.embed} title={`Karte: ${l.street}, ${l.city}`} class="aspect-[16/9] w-full border-0 grayscale-[30%]" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          <div class="p-7 sm:p-9">
            <p class="text-sm font-semibold uppercase tracking-widest text-berry-600">{l.area}</p>
            <h2 class="mt-2 text-3xl">{l.name}</h2>
            <dl class="mt-6 grid gap-5 text-[15px] sm:grid-cols-2">
              <div>
                <dt class="text-sm text-muted">Adrese</dt>
                <dd class="mt-1 font-medium">{l.street}, {l.city}</dd>
                {l.note && <dd class="text-sm text-muted">{l.note}</dd>}
              </div>
              <div>
                <dt class="text-sm text-muted">{t('hours')}</dt>
                <dd class="mt-1 font-medium">{l.hours.map((h) => <>{h.days} {h.time}<br /></>)}</dd>
              </div>
              <div>
                <dt class="text-sm text-muted">Tālrunis</dt>
                <dd class="mt-1 font-medium"><a href={telHref(l.phone)} class="hover:text-navy-800">{l.phone}</a></dd>
                <dd class="font-medium"><a href={telHref(l.mobile)} class="hover:text-navy-800">{l.mobile}</a> <span class="text-sm font-normal text-muted">(mob.)</span></dd>
              </div>
              <div>
                <dt class="text-sm text-muted">E-pasts</dt>
                <dd class="mt-1 font-medium"><a href={`mailto:${l.email}`} class="hover:text-navy-800">{l.email}</a></dd>
              </div>
            </dl>
            <div class="mt-7 flex flex-wrap gap-2.5">
              <a href={l.maps} class="btn border border-navy-200 text-navy-800 hover:border-navy-800"><Icon name="pin" size={16} />Google Maps</a>
              <a href={l.waze} class="btn border border-navy-200 text-navy-800 hover:border-navy-800">Waze</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="forma" class="scroll-mt-28 pb-6">
    <div class="container-x grid gap-6 lg:grid-cols-12">
      <div class="rounded-[2rem] bg-navy-900 p-7 text-white sm:p-10 lg:col-span-7 lg:p-14">
        <p class="eyebrow text-berry-500">Raksti mums</p>
        <h2 class="mt-4 text-3xl text-white sm:text-4xl">{t('form.title')}</h2>
        <div class="mt-8"><ContactForm dark /></div>
      </div>
      <div class="rounded-[2rem] bg-white p-7 ring-1 ring-sand-200 sm:p-10 lg:col-span-5">
        <h2 class="text-2xl">Rekvizīti</h2>
        <div class="mt-6 space-y-6 text-[15px]">
          {requisites.map((r) => (
            <dl>
              <dt class="font-semibold text-navy-900">{r.name}</dt>
              <dd class="mt-1 text-ink/80">Reģ. Nr. {r.reg} · PVN {r.vat}</dd>
              <dd class="text-ink/80">Jurid. adrese: {r.address}</dd>
              {r.banks.map((b) => <dd class="text-muted">{b}</dd>)}
            </dl>
          ))}
        </div>
        <div class="mt-8 border-t border-sand-200 pt-6 text-[15px]">
          <p class="text-muted">Kopējais tālrunis un e-pasts</p>
          <p class="mt-1 font-medium"><a href={company.phoneHref} class="hover:text-navy-800">{company.phone}</a> · <a href={`mailto:${company.email}`} class="hover:text-navy-800">{company.email}</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container-x">
      <h2 class="text-3xl sm:text-4xl">Mūsu komanda</h2>
      <p class="mt-3 text-lg text-muted">Projektu vadītāji palīdzēs izvēlēties labāko risinājumu jūsu telpām.</p>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {team.map((m) => (
          <li class="rounded-3xl bg-white p-6 ring-1 ring-sand-200">
            <span class="grid size-12 place-items-center rounded-full bg-navy-50 font-display text-lg text-navy-800">{m.name.split(' ').map((w) => w[0]).join('')}</span>
            <p class="mt-4 font-semibold text-navy-900">{m.name}</p>
            <p class="text-sm text-muted">{m.role}</p>
            <ul class="mt-4 space-y-1 text-[15px] text-ink/80">
              {m.phone && <li><a href={telHref(m.phone)} class="hover:text-navy-800">{m.phone}</a>{m.whatsapp && <span class="text-sm text-muted"> · WhatsApp</span>}</li>}
              {m.tel && <li><a href={telHref(m.tel)} class="hover:text-navy-800">{m.tel}</a></li>}
              {m.email && <li><a href={`mailto:${m.email}`} class="hover:text-navy-800">{m.email}</a></li>}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
