---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  center?: boolean;
}
const { eyebrow, title, intro, center = false } = Astro.props;
---

<div class:list={['max-w-2xl', center && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="mt-4 text-4xl sm:text-5xl">{title}</h2>
  {intro && <p class="mt-5 text-lg leading-relaxed text-muted">{intro}</p>}
  <slot />
</div>
