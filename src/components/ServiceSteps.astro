---
import Icon from './Icon.astro';

const steps = [
  { icon: 'chat', title: 'Konsultācija', text: 'Salonā bez maksas vai izbraukumā ar paraugiem – palīdzēsim atrast labāko tehnisko risinājumu.' },
  { icon: 'ruler', title: 'Mērīšana', text: 'Katrs milimetrs ir svarīgs. Mūsu speciālisti veic precīzus mērījumus visā Latvijā.' },
  { icon: 'scissors', title: 'Izgatavošana', text: 'Žalūzijas ražojam savā fabrikā Rīgā, aizkarus šujam pēc individuāla pasūtījuma.' },
  { icon: 'wrench', title: 'Uzstādīšana', text: 'Uzstādām, noregulējam, aizkarus nogludinām un sakopjam aiz sevis darba vietu.' },
] as const;
---

<section class="bg-navy-950 py-20 text-white lg:py-28">
  <div class="container-x">
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end">
      <div>
        <p class="eyebrow text-berry-500">Pilns serviss</p>
        <h2 class="mt-4 text-4xl text-white sm:text-5xl">No pirmā jautājuma līdz uzstādītam logam</h2>
      </div>
      <p class="max-w-xl text-lg leading-relaxed text-white/65 lg:justify-self-end">
        Darām visu, lai jums par neko nebūtu jāuztraucas. Mūsu projektu vadītāji ieteiks labāko tehnisko risinājumu tieši jūsu vēlmēm un situācijai.
      </p>
    </div>
    <ol class="mt-14 grid gap-px overflow-hidden rounded-3xl bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s, i) => (
        <li class="reveal bg-navy-950 p-7 lg:p-8" style={`transition-delay:${i * 90}ms`}>
          <div class="flex items-center justify-between">
            <span class="grid size-12 place-items-center rounded-full bg-white/10 text-white"><Icon name={s.icon} size={22} /></span>
            <span class="font-display text-5xl text-white/10">0{i + 1}</span>
          </div>
          <h3 class="mt-8 text-2xl text-white">{s.title}</h3>
          <p class="mt-3 leading-relaxed text-white/60">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
