---
import { Image } from 'astro:assets';
import hero from '../assets/hero.jpg';
import Icon from './Icon.astro';
import { company } from '../data/site';
import { t } from '../i18n/lv';

const years = new Date().getFullYear() - company.founded;
---

<section class="relative overflow-hidden">
  <div class="container-x grid items-center gap-10 pb-16 pt-10 lg:grid-cols-12 lg:gap-12 lg:pb-24 lg:pt-16">
    <div class="lg:col-span-5">
      <p class="eyebrow">Ražots Latvijā kopš {company.founded}</p>
      <h1 class="mt-5 text-[2.6rem] leading-[1.05] sm:text-6xl lg:text-[4.2rem]">
        Logu noformējums, kas <em class="font-normal italic text-berry-600">pielāgots</em> jūsu mājai
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted">
        Žalūzijas, aizkari un āra ēnošanas sistēmas – no bezmaksas konsultācijas un precīziem mērījumiem līdz
        izgatavošanai mūsu fabrikā un uzstādīšanai visā Latvijā.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/produkti/" class="btn-primary">{t('cta.products')} <Icon name="arrow" size={16} /></a>
        <a href="/kontakti/#forma" class="btn border border-navy-200 text-navy-800 hover:border-navy-800">{t('cta.measure')}</a>
      </div>
      <dl class="mt-12 grid max-w-md grid-cols-3 gap-6 border-t border-sand-200 pt-8">
        <div><dt class="text-sm text-muted">pieredze</dt><dd class="font-display text-3xl text-navy-900">{years}+ g.</dd></div>
        <div><dt class="text-sm text-muted">audumu ražotāji</dt><dd class="font-display text-3xl text-navy-900">20+</dd></div>
        <div><dt class="text-sm text-muted">saloni Rīgā</dt><dd class="font-display text-3xl text-navy-900">2</dd></div>
      </dl>
    </div>
    <div class="relative lg:col-span-7">
      <div class="relative overflow-hidden rounded-[2rem] shadow-2xl shadow-navy-950/15">
        <Image
          src={hero}
          alt="Pelēkas plisētās žalūzijas gaišā ēdamistabā"
          widths={[640, 960, 1280, 1536]}
          sizes="(min-width: 1024px) 58vw, 100vw"
          class="aspect-[4/3] w-full object-cover lg:aspect-[7/6]"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="mt-4 flex items-center gap-4 rounded-2xl bg-white/95 p-4 shadow-xl shadow-navy-950/10 backdrop-blur sm:absolute sm:-bottom-6 sm:right-8 sm:mt-0 sm:max-w-xs">
        <span class="grid size-12 shrink-0 place-items-center rounded-full bg-berry-600/10 text-berry-600"><Icon name="ruler" size={22} /></span>
        <p class="text-sm leading-snug text-ink/80"><strong class="block text-navy-900">Bezmaksas konsultācija</strong>mūsu salonos Pārdaugavā un Rīgas centrā</p>
      </div>
    </div>
  </div>
</section>
