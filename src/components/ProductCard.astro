---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Product } from '../lib/catalog';
import { productHref } from '../lib/catalog';

interface Props {
  entry: Product;
  blurb?: string;
  size?: 'lg' | 'md';
  eager?: boolean;
}
const { entry, blurb, size = 'md', eager = false } = Astro.props;
const { title, cover, coverAlt } = entry.data;
---

<a href={productHref(entry.id)} class="group card-lift relative flex h-full flex-col overflow-hidden rounded-3xl bg-white ring-1 ring-sand-200">
  <div class:list={['relative overflow-hidden bg-sand-100', size === 'lg' ? 'aspect-[4/5]' : 'aspect-[4/3]']}>
    {cover && (
      <Image
        src={cover}
        alt={coverAlt ?? title}
        widths={[400, 640, 900]}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        class="h-full w-full object-cover transition duration-700 ease-out-soft group-hover:scale-[1.04]"
        loading={eager ? 'eager' : 'lazy'}
      />
    )}
  </div>
  <div class="flex flex-1 items-start justify-between gap-4 p-5 sm:p-6">
    <div>
      <h3 class="text-xl leading-snug">{title}</h3>
      {blurb && <p class="mt-2 text-[15px] leading-relaxed text-muted">{blurb}</p>}
    </div>
    <span class="mt-1 grid size-9 shrink-0 place-items-center rounded-full bg-navy-50 text-navy-800 transition group-hover:bg-navy-800 group-hover:text-white">
      <Icon name="arrow" size={16} />
    </span>
  </div>
</a>
