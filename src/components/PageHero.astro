---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  lead?: string;
  crumbs: { title: string; href?: string }[];
  image?: ImageMetadata;
  imageAlt?: string;
}
const { title, lead, crumbs, image, imageAlt } = Astro.props;
---

<section class="border-b border-sand-200">
  <div class:list={['container-x grid gap-10 py-10 lg:py-14', image && 'lg:grid-cols-12 lg:items-center']}>
    <div class="lg:col-span-6">
      <Breadcrumbs items={crumbs} />
      <h1 class="mt-6 text-4xl leading-[1.08] sm:text-5xl lg:text-6xl">{title}</h1>
      {lead && <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">{lead}</p>}
      <div class="mt-8 flex flex-wrap gap-3"><slot /></div>
    </div>
    {image && (
      <div class="lg:col-span-6">
        <Image
          src={image}
          alt={imageAlt ?? title}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="aspect-[4/3] w-full rounded-[2rem] object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )}
  </div>
</section>
